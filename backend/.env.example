APP_NAME=trustPool API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
# Supabase: postgresql+psycopg://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/trustpool
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
EMAIL_VERIFICATION_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=30

# Optional provider adapter identifier; no email is delivered until configured.
EMAIL_PROVIDER=
# Development only: optional local outbox file for email/reset links. Never use in production.
# DEV_EMAIL_OUTBOX_PATH=.dev-email-outbox.txt

# Phase 9 — Cloudinary image storage (required for evidence/condition report uploads)
# https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Phase 11 — OpenAI (required for AI features)
# Set AI_ENABLED=false to run without AI — all endpoints will use deterministic fallbacks
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_ENABLED=false
